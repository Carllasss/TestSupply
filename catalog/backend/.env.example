# Провайдер модели: openai (по умолчанию) или local (Ollama/LM Studio и т.п.,
# любой OpenAI-совместимый сервер).
LLM_PROVIDER=openai

# Нужен только если LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Опционально: SOCKS5-прокси для запросов к OpenAI (например, если сервер в
# стране, откуда OpenAI API недоступен напрямую). См. shadowsocks-сервис в
# корневом docker-compose.yml — там прописывается автоматически как
# socks5://shadowsocks:1080, когда задан SHADOWSOCKS_SERVER в корневом .env.
OPENAI_PROXY_URL=

# Нужны только если LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

DATABASE_URL=postgresql://suppliers:suppliers@localhost:5432/suppliers
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CACHE_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5190
